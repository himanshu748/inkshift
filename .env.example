# Server-only Sanity write credentials. Never prefix a token with NEXT_PUBLIC_.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_TOKEN=
INKSHIFT_REQUIRE_SANITY=true

# Public IDs for the anonymous, schedule-only App SDK projection.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only Hugging Face Inference Providers token, or VISION_API_KEY.
HF_TOKEN=
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct:novita
VISION_BASE_URL=https://router.huggingface.co/v1

# Shared persisted demo limits; providers may impose additional limits/costs.
INKSHIFT_DAILY_EVENT_LIMIT=150
INKSHIFT_DAILY_PHOTO_LIMIT=40
